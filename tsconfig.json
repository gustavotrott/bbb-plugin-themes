{
  "compilerOptions": {
    "outDir": "./dist-tsc/",
    "noImplicitAny": true,
    "module": "es2020",
    "target": "es2018",
    "lib": ["es2018", "dom"],
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
